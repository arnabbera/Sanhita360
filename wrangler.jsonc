{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nagariksuraksha",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-27",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/qa/*", "/services/*", "/courses/*", "/sitemap.xml", "/posts/*", "/live-online-classes*", "/llb-courses*", "/legal-updates/*", "/legal-remedies/*", "/share/*"]
  }
}
